# Optional LLM enhancement. The app works without an LLM key using its deterministic parser.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Runtime controls
MAX_FILE_SIZE_MB=15
MAX_PAGES=3
OCR_ENABLED=true
UPLOAD_DIR=./uploads

# Local development: SQLite (zero configuration)
DATABASE_URL=sqlite:///./documents.db

# Deployment: use a persistent PostgreSQL connection string instead, e.g. Supabase.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
